# Copie para .env (que NUNCA vai para o Git) e preencha. Padrão: SCREAMING_SNAKE_CASE com prefixo de domínio.

# --- Servidor ---
APP_ENV=local            # local | development | staging | production
SERVER_PORT=8101

# --- Banco e integrações ---
ERP_DB_URL=
ERP_DB_USER=
ERP_DB_PASS=
AFETADOS_DB_URL=
AFETADOS_DB_USER=
AFETADOS_DB_PASS=
AUTOISP_AUTH_ENDPOINT=
AUTOISP_EVENTS_URL=
AUTOISP_USERNAME=
AUTOISP_PASSWORD=
ELLEVEN_CLIENT_ID=
ELLEVEN_CLIENT_SECRET=
ELLEVEN_CLIENT_SYNDATA=
ELLEVEN_CLIENT_GRANT_TYPE=
ELLEVEN_CLIENT_SCOPE=

# --- Observabilidade ---
LOG_LEVEL=INFO
ELASTIC_APM_SERVER_URL=  # vazio = APM desligado (obrigatório no CI)
